#!/bin/sh
# post-checkout — hydrate the SQLite cache after branch switch / clone (KIT-T097)
DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
node "$DIR/../scripts/hydrate-db.mjs" >/dev/null 2>&1 || true

# Git LFS, only where the repo opts in (see lfs-enabled.sh). Chained AFTER
# hydrate and never replacing it: `git lfs install` OVERWRITES these files, and
# doing so once wiped the hydrate hooks for every adopted repo at a stroke
# (2026-08-04). Never run `git lfs install` where core.hooksPath points here.
. "$DIR/lfs-enabled.sh"
[ -n "$LFS_ON" ] && git lfs post-checkout "$@"
exit 0
